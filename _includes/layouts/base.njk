<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or metadata.title }}</title>
    <meta name="description" content="{{ description or metadata.description }}">
    <meta name="generator" content="{{ eleventy.generator }}">

    <link rel="stylesheet" href="{{ '/css/index.css' | url }}?v={{ assetHash.css }}">
    <link rel="stylesheet" href="{{ '/css/prism-base16-monokai.dark.css' | url }}">
    <link rel="stylesheet" href="{{ '/css/prism-diff.css' | url }}">
    <link rel="alternate" href="{{ metadata.feed.path | url }}" type="application/atom+xml" title="{{ metadata.title }}">
    <link rel="alternate" href="{{ metadata.jsonfeed.path | url }}" type="application/json" title="{{ metadata.title }}">
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="sidebar" aria-label="Main">
      <a class="site-title" href="{{ '/' | url }}">{{ metadata.title }}</a>

      {#- Read more about `eleventy-navigation` at https://www.11ty.dev/docs/plugins/navigation/ #}
      <ul class="nav">
      {%- for entry in collections.all | eleventyNavigation %}
        <li class="nav-item"><a href="{{ entry.url | url }}"{% if entry.url == page.url %} aria-current="page"{% endif %}>{{ entry.title }}</a></li>
      {%- endfor %}
      </ul>

      {%- set footLinks %}
        <a href="https://github.com/hotsoupisgood/myWebsite">GitHub</a>
        <a href="https://www.linkedin.com/in/lucas-henry-dataspace/">LinkedIn</a>
        <a href="mailto:contact@lucashenry.xyz">Contact</a>
        <a href="{{ metadata.feed.path | url }}">Feed</a>
      {%- endset %}
      <div class="sidebar-foot">{{ footLinks | safe }}
      </div>
    </nav>

    <div class="page">
      {%- if templateClass != 'tmpl-post' or eleventyNavigation %}
      <div class="image-subheader">
        <img src="{{ '/img/banner.webp' }}" alt="Collage of personal photographs">
      </div>
      {%- endif %}

      <main id="main"{% if templateClass %} class="{{ templateClass }}"{% endif %}>
        {{ content | safe }}
      </main>

      <footer class="page-foot">{{ footLinks | safe }}
      </footer>
    </div>
  </body>
</html>
