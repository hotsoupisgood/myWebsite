---
layout: layouts/base.njk
templateClass: tmpl-post
---
<div class="post-head">
  {%- if not eleventyNavigation %}
  {%- set back = tags | backTo %}
  <a href="{{ back.url | url }}" class="back-link" aria-label="Back to {{ back.label }}" title="Back to {{ back.label }}">&#8592;</a>
  {%- endif %}
  <h1>{{ title }}</h1>
</div>

{%- if not eleventyNavigation %}
<time datetime="{{ page.date | htmlDateString }}">{{ page.date | readableDate }}</time>
{%- endif %}
{%- for tag in tags | filterTagList -%}
{%- set tagUrl %}/tags/{{ tag | slug }}/{% endset -%}
<a href="{{ tagUrl | url }}" class="post-tag">{{ tag }}</a>
{%- endfor %}
<div class="read-more-target">
  {{ content | safe }}
</div>
<input type="checkbox" class="read-more-state" id="post-abc" />
