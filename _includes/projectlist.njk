<ol reversed class="cardlist">
{% for post in postslist | reverse %}
  {%- set auto = post.templateContent | firstImage %}
  {%- set thumbSrc = post.data.image or auto.src %}
  <li class="cardlist-item">

    <div class="cardlist-meta">
      <h2 class="cardlist-title"><a href="{{ post.url | url }}">{% if post.data.title %}{{ post.data.title }}{% else %}{{ post.url }}{% endif %}</a></h2>
      <time class="cardlist-date" datetime="{{ post.date | htmlDateString }}">{{ post.date | readableDate }}</time>
      {%- for tag in post.data.tags | filterTagList %}
        {%- set tagUrl %}/tags/{{ tag | slug }}/{% endset %}
        <a href="{{ tagUrl | url }}" class="post-tag">{{ tag }}</a>
      {%- endfor %}
    </div>

    <p class="cardlist-excerpt">{{ post.data.description or post.templateContent | excerpt(240) }}</p>

    {%- if thumbSrc %}
    <a class="cardlist-thumb" href="{{ post.url | url }}" tabindex="-1" aria-hidden="true">
      <img src="{{ thumbSrc | url }}" alt="" loading="lazy">
    </a>
    {%- endif %}

  </li>
{% endfor %}
</ol>
